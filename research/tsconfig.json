{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "paths": {
      "@mrlyprod/loader": ["../packages/js/loader/src/index.ts"],
      "@mrlyprod/draw": ["../packages/js/draw/src/index.ts"],
      "@mrlyprod/draw/*": ["../packages/js/draw/src/*"],
      "@mrlyprod/core": ["../data/packages/rs/bridge/js/core/index"],
      "@mrlyprod/font": ["../data/packages/rs/bridge/js/font/index"],
      "@mrlyprod/life": ["../data/packages/rs/bridge/js/life/index"],
      "@mrlyprod/math": ["../data/packages/rs/bridge/js/math/index"],
      "@mrlyprod/num": ["../data/packages/rs/bridge/js/num/index"],
      "@mrlyprod/tile": ["../data/packages/rs/bridge/js/tile/index"]
    }
  },
  "include": ["*/figures/*.ts", "shared/figures/*.ts"],
  "exclude": ["**/node_modules/**", "**/data/**", "**/target/**"]
}
