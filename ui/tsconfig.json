{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "typeRoots": ["../node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "paths": {
      "react": ["../node_modules/@types/react", "../node_modules/react"],
      "react/*": ["../node_modules/@types/react/*", "../node_modules/react/*"],
      "react-dom": ["../node_modules/@types/react-dom", "../node_modules/react-dom"],
      "react-dom/client": ["../node_modules/@types/react-dom/client", "../node_modules/react-dom/client"],
      "three": ["../node_modules/@types/three", "../node_modules/three/build/three.module.js"],
      "@mrlyprod/core": ["../packages/core/js/index"],
      "@mrlyprod/core/*": ["../packages/core/js/*"],
      "@mrlyprod/font": ["../packages/font/js/index"],
      "@mrlyprod/font/*": ["../packages/font/js/*"],
      "@mrlyprod/life": ["../packages/life/js/index"],
      "@mrlyprod/life/*": ["../packages/life/js/*"],
      "@mrlyprod/math": ["../packages/math/js/index"],
      "@mrlyprod/math/*": ["../packages/math/js/*"],
      "@mrlyprod/num": ["../packages/num/js/index"],
      "@mrlyprod/num/*": ["../packages/num/js/*"],
      "@mrlyprod/tile": ["../packages/tile/js/index"],
      "@mrlyprod/tile/*": ["../packages/tile/js/*"],
      "@mrlyprod/draw": ["../packages/draw/index.ts"],
      "@mrlyprod/draw/*": ["../packages/draw/*"],
      "@mrlyprod/os/*": ["../os/*"],
      "@mrlyprod/ui/*": ["./*"],
      "@mrlyprod/apps/*": ["../apps/*"],
      "@mrlyprod/designs/*": ["../designs/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/dist/**", "**/node_modules/**", "**/data/**"]
}
