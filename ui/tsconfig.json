{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "typeRoots": ["../node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "paths": {
      "react": ["../node_modules/@types/react", "../node_modules/react"],
      "react/*": ["../node_modules/@types/react/*", "../node_modules/react/*"],
      "react-dom": ["../node_modules/@types/react-dom", "../node_modules/react-dom"],
      "react-dom/client": ["../node_modules/@types/react-dom/client", "../node_modules/react-dom/client"],
      "@mrlyprod/core": ["../data/packages/rs/bridge/js/core/index"],
      "@mrlyprod/core/*": ["../data/packages/rs/bridge/js/core/*"],
      "@mrlyprod/font": ["../data/packages/rs/bridge/js/font/index"],
      "@mrlyprod/font/*": ["../data/packages/rs/bridge/js/font/*"],
      "@mrlyprod/life": ["../data/packages/rs/bridge/js/life/index"],
      "@mrlyprod/life/*": ["../data/packages/rs/bridge/js/life/*"],
      "@mrlyprod/math": ["../data/packages/rs/bridge/js/math/index"],
      "@mrlyprod/math/*": ["../data/packages/rs/bridge/js/math/*"],
      "@mrlyprod/num": ["../data/packages/rs/bridge/js/num/index"],
      "@mrlyprod/num/*": ["../data/packages/rs/bridge/js/num/*"],
      "@mrlyprod/tile": ["../data/packages/rs/bridge/js/tile/index"],
      "@mrlyprod/tile/*": ["../data/packages/rs/bridge/js/tile/*"],
      "@mrlyprod/loader": ["../packages/js/loader/src/index.ts"],
      "@mrlyprod/draw": ["../packages/js/draw/src/index.ts"],
      "@mrlyprod/draw/*": ["../packages/js/draw/src/*"],
      "@mrlyprod/os/*": ["../os/*"],
      "@mrlyprod/ui/*": ["./*"],
      "@mrlyprod/apps/*": ["../apps/*"],
      "@mrlyprod/designs/*": ["../designs/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/dist/**", "**/node_modules/**", "**/data/**"]
}
