{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "typeRoots": ["../node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@mrlyprod/*": ["../data/packages/rs/bindgen/js/*/index", "../data/packages/rs/bindgen/js/*"],
      "react": ["../node_modules/@types/react", "../node_modules/react"],
      "react/*": ["../node_modules/@types/react/*", "../node_modules/react/*"],
      "react-dom": ["../node_modules/@types/react-dom", "../node_modules/react-dom"],
      "react-dom/client": ["../node_modules/@types/react-dom/client", "../node_modules/react-dom/client"],
      "@mrlyprod/loader": ["../packages/js/loader/src/index.ts"],
      "@mrlyprod/draw": ["../packages/js/draw/src/index.ts"],
      "@mrlyprod/draw/*": ["../packages/js/draw/src/*"],
      "@mrlyprod/os/*": ["../os/*"],
      "@mrlyprod/ui/*": ["./*"],
      "@mrlyprod/apps/*": ["../apps/*"],
      "@mrlyprod/designs/*": ["../designs/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/dist/**", "**/node_modules/**", "**/data/**"]
}
