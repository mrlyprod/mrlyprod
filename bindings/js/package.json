{
  "name": "@mrlyprod/mrly",
  "version": "0.2.0",
  "description": "MrlyMath, the mathematics of designs, compiled to WebAssembly for the browser and Node.",
  "keywords": [
    "mathematics",
    "fractal",
    "cellular-automata",
    "generative",
    "wasm",
    "webassembly"
  ],
  "author": "MrlyProd, Inc.",
  "license": "MIT",
  "homepage": "https://mrly.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrlyprod/mrlyprod",
    "directory": "bindings/js"
  },
  "bugs": {
    "url": "https://github.com/mrlyprod/mrlyprod/issues"
  },
  "type": "module",
  "sideEffects": [
    "./*.node.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": "./index.node.js",
      "default": "./index.js"
    },
    "./core": {
      "types": "./core.d.ts",
      "node": "./core.node.js",
      "default": "./core.js"
    },
    "./font": {
      "types": "./font.d.ts",
      "node": "./font.node.js",
      "default": "./font.js"
    },
    "./life": {
      "types": "./life.d.ts",
      "node": "./life.node.js",
      "default": "./life.js"
    },
    "./math": {
      "types": "./math.d.ts",
      "node": "./math.node.js",
      "default": "./math.js"
    },
    "./num": {
      "types": "./num.d.ts",
      "node": "./num.node.js",
      "default": "./num.js"
    },
    "./tile": {
      "types": "./tile.d.ts",
      "node": "./tile.node.js",
      "default": "./tile.js"
    },
    "./pkg/*": "./pkg/*",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "pkg/",
    "index.js",
    "index.node.js",
    "index.d.ts",
    "core.js",
    "core.node.js",
    "core.d.ts",
    "font.js",
    "font.node.js",
    "font.d.ts",
    "life.js",
    "life.node.js",
    "life.d.ts",
    "math.js",
    "math.node.js",
    "math.d.ts",
    "num.js",
    "num.node.js",
    "num.d.ts",
    "tile.js",
    "tile.node.js",
    "tile.d.ts"
  ],
  "scripts": {
    "test": "bun test"
  }
}
