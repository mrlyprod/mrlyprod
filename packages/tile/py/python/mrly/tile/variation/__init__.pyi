from typing import Any, Literal

from numpy.typing import NDArray
import mrly.core
import mrly.tile

class File:
    def __init__(self, width: int, height: int) -> None: ...
    @property
    def width(self) -> int:
        ...
    @width.setter
    def width(self, value: int) -> None: ...
    @property
    def height(self) -> int:
        ...
    @height.setter
    def height(self, value: int) -> None: ...
    @property
    def image(self) -> NDArray[Any] | None:
        ...
    @image.setter
    def image(self, value: NDArray[Any] | None) -> None: ...
    @staticmethod
    def new(width: int, height: int) -> File:
        ...
    @staticmethod
    def from_dict(data: Any) -> File:
        ...
    def to_dict(self) -> Any:
        ...

class Variation:
    @property
    def key(self) -> str:
        ...
    @key.setter
    def key(self, value: str) -> None: ...
    @property
    def seed(self) -> int:
        ...
    @seed.setter
    def seed(self, value: int) -> None: ...
    @property
    def edition(self) -> Literal["Simple", "Index", "Layers", "Neighbors", "Rows", "Columns", "Random"]:
        ...
    @edition.setter
    def edition(self, value: Literal["Simple", "Index", "Layers", "Neighbors", "Rows", "Columns", "Random"]) -> None: ...
    @property
    def primaries(self) -> list[Literal["Black", "White", "Red", "Orange", "Yellow", "Green", "Mint", "Teal", "Cyan", "Blue", "Indigo", "Purple", "Pink", "Brown", "Gray"]] | None:
        ...
    @primaries.setter
    def primaries(self, value: list[Literal["Black", "White", "Red", "Orange", "Yellow", "Green", "Mint", "Teal", "Cyan", "Blue", "Indigo", "Purple", "Pink", "Brown", "Gray"]] | None) -> None: ...
    @property
    def tile(self) -> mrly.tile.Tile:
        ...
    @tile.setter
    def tile(self, value: mrly.tile.Tile) -> None: ...
    @property
    def mask(self) -> mrly.tile.Tile | None:
        ...
    @mask.setter
    def mask(self, value: mrly.tile.Tile | None) -> None: ...
    @property
    def base(self) -> dict[str, Any] | None:
        ...
    @base.setter
    def base(self, value: dict[str, Any] | None) -> None: ...
    @property
    def files(self) -> list[File]:
        ...
    @files.setter
    def files(self, value: list[File]) -> None: ...
    def is_cover(self) -> bool:
        ...
    def is_prime(self) -> bool:
        ...
    @staticmethod
    def from_dict(data: Any) -> Variation:
        ...
    def to_dict(self) -> Any:
        ...

class Config:
    @staticmethod
    def default() -> dict[str, Any]:
        ...

def create(config: dict[str, Any], rng: mrly.core.Rng) -> Variation:
    ...

def generate(variation: Variation, config: dict[str, Any], rng: mrly.core.Rng) -> Variation:
    ...

def render(variation: Variation, scale: int, rng: mrly.core.Rng) -> Variation:
    ...
