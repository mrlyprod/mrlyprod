{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "paths": {
      "@mrlyprod/draw": ["./src/index.ts"],
      "@mrlyprod/draw/*": ["./src/*"],
      "@mrlyprod/core": ["../../../data/packages/rs/bridge/js/core/index"],
      "@mrlyprod/loader": ["../loader/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "examples/**/*.ts"],
  "exclude": ["**/node_modules/**"]
}
