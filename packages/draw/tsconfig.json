{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "paths": {
      "@mrlyprod/draw": ["./index.ts"],
      "@mrlyprod/draw/*": ["./*"],
      "@mrlyprod/core": ["../core/js/index"]
    }
  },
  "include": ["*.ts"],
  "exclude": ["**/node_modules/**"]
}
