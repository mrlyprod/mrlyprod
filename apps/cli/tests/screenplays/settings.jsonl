{"tap": {"verb": "settings.set", "args": {"key": "darkmode", "value": false}}}
{"ask": "settings.set {\"key\":\"pace\",\"value\":0}"}
{"run": true}
{"assert": {"state": ["settings/pace", 0]}}
{"focus": {"verb": "settings.set"}}
{"cap": "red"}
