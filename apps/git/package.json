{
  "name": "git",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun x --bun vite",
    "site": "bun x --bun vite build",
    "data": "bun scripts/build.ts",
    "build": "bun run site && bun run data",
    "links": "bun scripts/links.ts",
    "preview": "bun run build && bun x --bun vite preview",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@shikijs/langs": "^4.3.1",
    "mrlycss": "workspace:*",
    "mrlydom": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.3.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/hast": "^3.0.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^8.0.16"
  }
}
