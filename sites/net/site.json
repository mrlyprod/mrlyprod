{
  "title": "MrlyNet",
  "cli": "mrlynet",
  "wordmark": "MRLYNET",
  "root": "https://mrly.net",
  "since": 2013,
  "prefix": "mrly-",
  "mark": "/favicon.svg",
  "marks": { "png": "/favicon.png", "touch": "/apple-touch-icon.png", "og": "/og.png" },
  "tint": "indigo",
  "menu": "/menu/",
  "desk": "tiles",
  "tiles": { "id": "tiles", "title": "Tiles" },
  "designs": [
    "../../designs/modern",
    "../../designs/boxy",
    "../../designs/bricks",
    "../../designs/classic",
    "../../designs/terminal"
  ],
  "roots": [],
  "apps": [
    "ads",
    "archive",
    "books",
    "calc",
    "calendar",
    "clock",
    "code",
    "dating",
    "docs",
    "feedback",
    "files",
    "git",
    "health",
    "help",
    "identity",
    "jobs",
    "logs",
    "mail",
    "maps",
    "market",
    "messages",
    "music",
    "news",
    "notes",
    "notifications",
    "numbers",
    "papers",
    "people",
    "phone",
    "photos",
    "podcasts",
    "reminders",
    "screensavers",
    "search",
    "settings",
    "sites",
    "slides",
    "stats",
    "stocks",
    "term",
    "tv",
    "vote",
    "wallet",
    "weather",
    "wiki",
    "wish",
    "kit"
  ],
  "screen": [1440, 900, 2],
  "min": [1280, 720],
  "company": "MrlyProd, Inc.",
  "tree": [
    {
      "name": "Root",
      "nodes": [
        { "name": "robots.txt", "href": "/robots.txt" },
        { "name": "sitemap.xml", "href": "/sitemap.xml" },
        { "name": "llms.txt", "href": "/llms.txt" },
        { "name": "404.html", "href": "/404.html" }
      ]
    }
  ],
  "socials": [{ "name": "GitHub", "href": "https://github.com/mrlyprod" }],
  "contact": "help@mrly.net",
  "shots": {
    "routes": ["/", "/menu/", "/settings/", "/screensavers/", "/stats/", "/kit/", "/git/site.json"]
  },
  "push": {
    "prefix": "",
    "guard": ["cdn/", "stats/stats.json"],
    "bucket": "MRLYNET_BUCKET",
    "store": { "bucket": "MRLYDEV_BUCKET", "prefix": "build/net" }
  },
  "git": { "root": ".", "slug": "mrlyprod/mrlyprod", "branch": "main", "folder": "sites/net" },
  "fonts": {
    "out": "shared/fonts",
    "keep": "shared/fonts/keep.css",
    "faces": [
      { "family": "Noto Sans", "file": "sans", "axes": "wght@400..700", "weight": "400 700", "licence": "notosans" },
      { "family": "Noto Serif", "file": "serif", "axes": "wght@400..700", "weight": "400 700", "licence": "notoserif" },
      {
        "family": "Noto Sans Mono",
        "file": "mono",
        "axes": "wght@400..700",
        "weight": "400 700",
        "licence": "notosansmono"
      },
      { "family": "Noto Sans Math", "file": "math", "weight": "400", "licence": "notosansmath" },
      { "family": "Noto Color Emoji", "file": "emoji", "weight": "400", "licence": "notocoloremoji" }
    ]
  },
  "icons": {
    "names": [
      "casino",
      "check",
      "chevron_right",
      "close",
      "download",
      "expand_more",
      "fullscreen_exit",
      "graphic_eq",
      "grid_view",
      "info",
      "ios_share",
      "keyboard",
      "keyboard_command_key",
      "left_panel_close",
      "left_panel_open",
      "link",
      "more_horiz",
      "music_note",
      "right_panel_close",
      "right_panel_open",
      "search",
      "shift",
      "star",
      "star_fill",
      "tune",
      "volume_up"
    ],
    "out": "kit/icons.gen.js"
  }
}
