{
  "spec": "0.1",
  "title": "Act",
  "line": "One act in: the only way anything changes.",
  "type": "object",
  "properties": {
    "verb": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
    },
    "args": {
      "type": "object"
    },
    "who": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": "string"
        },
        "kind": {
          "enum": ["human", "org", "bot", "agent"]
        }
      },
      "required": ["id", "kind"],
      "additionalProperties": false
    },
    "at": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["verb"],
  "additionalProperties": false
}
