{
  "spec": "0.1",
  "title": "Manifest",
  "line": "What an installed app is: its name, its verbs, its beat.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "user": {},
    "title": {
      "type": "string"
    },
    "line": {
      "type": "string"
    },
    "verbs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
      }
    },
    "beat": {}
  },
  "required": ["id", "user", "title", "line", "verbs", "beat"],
  "additionalProperties": false
}
