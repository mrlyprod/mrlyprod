{
  "spec": "0.1",
  "title": "Fault",
  "line": "A broken request: one code, one plain note. A refusal is never a fault.",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": ["bad-act", "bad-config", "unknown-verb", "unknown-world", "no-iden", "refused", "spec-mismatch"]
        },
        "note": {
          "type": "string"
        }
      },
      "required": ["code", "note"],
      "additionalProperties": false
    }
  },
  "required": ["error"],
  "additionalProperties": false
}
