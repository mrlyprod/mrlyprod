{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "net/**",
      "designs/**",
      "apps/**",
      "org/**",
      "draw/**",
      "research/**/figures/**",
      "aws/**",
      "!**/*.gen.*",
      "!**/*.svg",
      "!**/*.html",
      "!**/*.md",
      "!net/hosts/web/infra/edge.js",
      "!designs/shared/fonts",
      "!research/**/figures/*.json",
      "!net/mrly.net/launchpad.json",
      "!apps/shared/sequences/records.json",
      "!net/system/stats/fixture.json"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 120, "includes": ["**"] },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": { "noAriaHiddenOnFocusable": "off", "noStaticElementInteractions": "off", "useSemanticElements": "off" },
      "complexity": { "noImportantStyles": "off" },
      "correctness": { "noComponentHookFactories": "off", "useExhaustiveDependencies": "off" },
      "security": { "noDangerouslySetInnerHtml": "off" },
      "style": { "noDescendingSpecificity": "off", "noNonNullAssertion": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["designs/glass/dock.tsx", "net/system/stats/index.tsx"],
      "linter": { "rules": { "suspicious": { "noArrayIndexKey": "off" } } }
    }
  ]
}
