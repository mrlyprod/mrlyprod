{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "paths": {
      "@mrlyprod/core": ["../core/js/index"],
      "@mrlyprod/core/*": ["../core/js/*"],
      "@mrlyprod/font": ["../font/js/index"],
      "@mrlyprod/font/*": ["../font/js/*"],
      "@mrlyprod/life": ["../life/js/index"],
      "@mrlyprod/life/*": ["../life/js/*"],
      "@mrlyprod/math": ["../math/js/index"],
      "@mrlyprod/math/*": ["../math/js/*"],
      "@mrlyprod/num": ["../num/js/index"],
      "@mrlyprod/num/*": ["../num/js/*"],
      "@mrlyprod/tile": ["../tile/js/index"],
      "@mrlyprod/tile/*": ["../tile/js/*"],
      "@mrlyprod/draw": ["../draw/index.ts"],
      "@mrlyprod/draw/*": ["../draw/*"],
      "@mrlyprod/shell/*": ["./net/shell/*"],
      "@mrlyprod/sdk/*": ["./net/sdk/*"],
      "@mrlyprod/system/*": ["./net/system/*"],
      "@mrlyprod/modern": ["./designs/modern/index.ts"],
      "@mrlyprod/modern/*": ["./designs/modern/*"],
      "@mrlyprod/boxy": ["./designs/boxy/index.ts"],
      "@mrlyprod/boxy/*": ["./designs/boxy/*"],
      "@mrlyprod/classic": ["./designs/classic/index.ts"],
      "@mrlyprod/classic/*": ["./designs/classic/*"],
      "@mrlyprod/bricks": ["./designs/bricks/index.ts"],
      "@mrlyprod/bricks/*": ["./designs/bricks/*"],
      "@mrlyprod/terminal": ["./designs/terminal/index.ts"],
      "@mrlyprod/terminal/*": ["./designs/terminal/*"],
      "@mrlyprod/design-shared/*": ["./designs/shared/*"]
    }
  },
  "include": [
    "net/**/*.ts",
    "net/**/*.tsx",
    "org/**/*.ts",
    "org/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "aws/*.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
