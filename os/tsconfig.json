{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "typeRoots": ["../node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "lib": ["esnext", "dom", "dom.iterable"],
    "paths": {
      "@mrlyprod/os/*": ["./*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["**/node_modules/**", "**/data/**"]
}
