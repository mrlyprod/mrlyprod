{
  "spec": "0.2",
  "title": "Line",
  "line": "One journal line: an act stamped with its tick. Replay reads these and nothing else.",
  "type": "object",
  "properties": {
    "tick": { "type": "integer", "minimum": 1 },
    "at": { "type": "integer", "minimum": 0 },
    "who": {
      "type": "object",
      "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "minLength": 1 } },
      "required": ["id", "kind"],
      "additionalProperties": false
    },
    "verb": { "type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9]*$" },
    "args": { "type": "object" },
    "via": { "type": "string" }
  },
  "required": ["tick", "at", "who", "verb", "args"],
  "additionalProperties": false
}
