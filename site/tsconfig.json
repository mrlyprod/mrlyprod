{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "paths": {
      "@mrlyprod/mrly/*": ["../bindings/js/*"],
      "#view": ["./src/lib/view/index.ts"],
      "#view/*": ["./src/lib/view/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "infra/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "../research/**/figures/*.ts",
    "../aws/*.ts"
  ]
}
